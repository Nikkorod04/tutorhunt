# Firebase web app configuration.
#
# Copy this file to `.env` and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
#
# `.env` is gitignored. Only EXPO_PUBLIC_* variables are visible to the app,
# and they are embedded in the bundle — they are not secrets in the way a
# server key is, but the project still keeps them out of version control.
#
# Security comes from firestore.rules, not from hiding these values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
