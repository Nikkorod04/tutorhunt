# Firebase web app configuration.
#
# Copy this file to `.env` and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
#
# `.env` is gitignored. Only EXPO_PUBLIC_* variables are visible to the app,
# and they are embedded in the bundle — they are not secrets in the way a
# server key is, but the project still keeps them out of version control.
#
# Security comes from firestore.rules, not from hiding these values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client configuration.
# Use the Web application OAuth client ID for Firebase credential exchange.
# These values are public client identifiers, not private secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional web Firebase App Check reCAPTCHA v3 site key.
# Native App Check uses a native provider in an EAS development/production build.
EXPO_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
